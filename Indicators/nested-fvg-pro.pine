// © nested_fvg_indicator
// ► Run on a 1-MINUTE chart

//@version=6
indicator("Nested FVG Pro", overlay=true, max_boxes_count=500, max_labels_count=500, max_lines_count=500)

// ─────────────────────────────────────────────────────────
//  INPUTS
// ─────────────────────────────────────────────────────────
grp1 = "5-Minute FVG Settings"
fvg5_show      = input.bool(true,  "Show 5-min FVGs",                      group=grp1)
fvg5_bull_col  = input.color(color.new(#06b6d4, 88), "5-min Bullish Color", group=grp1, tooltip="HTF context zone — kept faint so the nested 1-min FVG reads as the signal.")
fvg5_bear_col  = input.color(color.new(#f87171, 88), "5-min Bearish Color", group=grp1)
fvg5_mitigated = input.bool(true,  "Remove 5-min FVG When Mitigated",       group=grp1)
fvg5_min_bp    = input.float(0.15, "5-min FVG Min Size (basis points)",     group=grp1, minval=0, maxval=100, step=0.05)

grp2 = "1-Minute FVG Settings"
fvg1_show      = input.bool(true,  "Show 1-min Nested FVGs",               group=grp2)
fvg1_bull_col  = input.color(color.new(#06b6d4, 72), "1-min Bullish Color", group=grp2, tooltip="The nested signal zone — more present than the faint 5-min HTF box.")
fvg1_bear_col  = input.color(color.new(#f87171, 72), "1-min Bearish Color", group=grp2)
fvg1_min_bp    = input.float(0.15, "1-min FVG Min Size (basis points)",     group=grp2)
fvg1_entry     = input.string("Immediate", "1-min FVG Entry Spot",         group=grp2, options=["Immediate","Near Edge","Middle","Far Edge"], tooltip="Where the entry sits within the 1-min FVG. Immediate = enter at market close the moment the FVG forms; Near Edge = shallowest pullback fill; Middle = 50% level; Far Edge = deepest fill (original behavior). Stop and all targets shift with the entry.")

grp3 = "Signal Settings"
sig_bull_col   = input.color(color.new(#06b6d4, 0), "Bullish Label Color",  group=grp3)
sig_bear_col   = input.color(color.new(#f87171, 0), "Bearish Label Color",  group=grp3)
alert_on_nest  = input.bool(true, "Alert on Nested FVG",                    group=grp3)
alert_partial  = input.bool(true, "Alert on Partial/BE Hit",                group=grp3)
alert_stop     = input.bool(true, "Alert on Stop Hit",                      group=grp3)
alert_target   = input.bool(true, "Alert on Target Hit",                    group=grp3)
cooldown_bars  = input.int(30, "Cooldown Between Signals (bars/mins)",       group=grp3, minval=1, maxval=120)
// Open Trade Handling — hardcoded to Block mode for safety
// New signals are ignored while a trade is open
string trade_mode = "Block new trades until open trade closes"
invalidate_partial = input.bool(true, "Invalidate If Partial Hit Before Entry", group=grp3, tooltip="For pullback entries (Near/Middle/Far Edge): if price reaches the partial target before the entry fills, cancel the pending setup as invalid. Does not apply to Immediate entries.")

grp6 = "Dynamic R/R Tool (Basis Points)"
rr_show        = input.bool(true,  "Show R/R Levels",                       group=grp6, tooltip="Master toggle for the R/R lines + risk/reward boxes on each signal.")
rr_show_pills  = input.bool(false, "Show R/R Pills (price tags)",           group=grp6, tooltip="Price-tagged labels (T2/Target/Anchor/Stop/Entry) at the right of each setup. Off by default to reduce clutter — the boxes + lines already show the levels; hover them for values.")
rr_show_size   = input.bool(true,  "Show Position Size badge",              group=grp6, tooltip="One compact '# Enter N MNQ' pill per signal at the entry.")
rr_label_size  = input.string("tiny", "R/R Label Size",                     group=grp6, options=["tiny","small","normal","large","huge"])

// 0.1% = 10 basis points (e.g., 30 points on a 30,000 NQ)
rr_stop_pct    = input.float(0.10, "Stop Loss (% of Price)",               group=grp6, minval=0.01, step=0.01)
rr_partial_pct = input.float(0.10, "Partial Target (% of Price)",          group=grp6, minval=0.01, step=0.01)
rr_target_pct  = input.float(0.15, "Main Target (% of Price)",             group=grp6, minval=0.01, step=0.01)
rr_ext_pct     = input.float(0.30, "Extended Target (% of Price)",         group=grp6, minval=0.01, step=0.01)

// Dynamic Contract Multiplier for Webhook Sizing Calculations
val_per_point  = input.float(2.0,  "Dollar Value Per Full Point",          group=grp6, tooltip="2.0 for MNQ, 20.0 for NQ")

rr_stop_col    = input.color(color.new(#f87171, 0), "Stop Color",           group=grp6)
rr_entry_col   = input.color(color.new(#fbbf24, 0), "Entry Color",          group=grp6)
rr_target_col  = input.color(color.new(#06b6d4, 0), "Target Color",         group=grp6)
rr_partial_col = input.color(color.new(#38bdf8, 0), "Partial Color",        group=grp6)
rr_ext_col     = input.color(color.new(#fbbf24, 0), "Extended Target Color", group=grp6)

grp8 = "Position Sizing & Management"
max_trade_risk_usd = input.float(480.0, "Max Dollar Risk per Trade ($)", group=grp8, minval=10.0, step=10.0, tooltip="Sizing will auto-calculate to stay under this.")
pos_be_at_partial  = input.bool(true, "Move Stop to Break-Even at Anchor/Partial", group=grp8)

grp7 = "Trade Tracker"
tbl_show       = input.bool(true,  "Show Trade Tracker Table",              group=grp7)
tbl_pos        = input.string("Bottom Right", "Table Position",             group=grp7, options=["Top Right","Top Left","Bottom Right","Bottom Left","Middle Right","Middle Left"])
tbl_size       = input.string("normal", "Table Text Size",                  group=grp7, options=["tiny","small","normal"])
tbl_max_rows   = input.int(10, "Max Rows to Display",                       group=grp7, minval=3, maxval=20)
tbl_tz_opt     = input.string("Auto (Chart/Exchange)", "Tracker Time Zone",  group=grp7, options=["Auto (Chart/Exchange)","America/New_York","America/Chicago","America/Denver","America/Los_Angeles","America/Sao_Paulo","Europe/London","Europe/Berlin","Asia/Tokyo","Asia/Shanghai","Asia/Kolkata","Australia/Sydney","UTC"], tooltip="Time zone for Date/Time columns and Today Only filter. Auto uses the symbol exchange timezone.")
tbl_today_only = input.bool(true,  "Today Only",                            group=grp7)
tbl_show_usd   = input.bool(true,  "Show $ P&L Column",                     group=grp7)
tbl_usd_per_pt = input.float(2.0,  "$ per Point",                           group=grp7, minval=0.0, step=0.5)
tbl_show_shown = input.bool(false, "Show Shown Trades Summary Row",         group=grp7, tooltip="Off by default — duplicates the TODAY row when few trades are shown.")
tbl_hourly     = input.bool(false, "Show Hourly Performance Table",         group=grp7, tooltip="Off by default to reduce chart clutter. The per-hour Win%/PnL/Rating breakdown.")
tbl_hourly_pos = input.string("Bottom Left", "Hourly Table Position",       group=grp7, options=["Top Right","Top Left","Bottom Right","Bottom Left","Middle Right","Middle Left"])
tbl_theme      = input.string("Dark", "Table Theme",                           group=grp7, options=["Dark","Light"])
tbl_weekly     = input.bool(false, "Show Weekly Summary Table",            group=grp7, tooltip="Off by default to reduce chart clutter. The Mon–Fri per-day P&L rollup.")
tbl_weekly_pos = input.string("Top Left", "Weekly Table Position",         group=grp7, options=["Top Right","Top Left","Bottom Right","Bottom Left","Middle Right","Middle Left"])

grp5 = "Proximity Filter"
proximity_bp   = input.float(5.0, "Proximity (basis points)",               group=grp5, minval=0, maxval=100, step=0.5)

grp4 = "Time Filter"
sess_string    = input.session("1900-1600:1234567", "Session (Exchange Time)", group=grp4)
stop_hour_ct   = input.int(16,    "Stop Trading At Hour (CT, 24h)",            group=grp4, minval=0, maxval=23, tooltip="No new signals at or after this hour CT. Default 16 = 4:00 PM CT.")
dll_enabled    = input.bool(true, "Enable Daily Loss Limit",                   group=grp4)
dll_usd        = input.float(400.0, "Daily Loss Limit ($)",                    group=grp4, minval=0, step=50, tooltip="No new signals once daily losses reach this dollar amount.")

grpH = "Trading Windows (Chicago Time)"
use_windows    = input.bool(true,  "Use Trading Windows",                       group=grpH, tooltip="Only allow signals during the selected hour windows.")
win_7pm        = input.bool(true,  "7:00 PM – 9:00 PM  (evening open)",        group=grpH)
win_1am        = input.bool(true,  "1:00 AM – 2:00 AM  (overnight)",           group=grpH)
win_6am        = input.bool(true,  "6:00 AM – 11:00 AM (morning session)",     group=grpH)
win_12pm       = input.bool(true,  "12:00 PM – 2:00 PM (afternoon session)",   group=grpH)

// ─────────────────────────────────────────────────────────
//  CONVERSIONS
// ─────────────────────────────────────────────────────────
rr_sz = switch rr_label_size
    "tiny"   => size.tiny
    "small"  => size.small
    "normal" => size.normal
    "large"  => size.large
    => size.huge

tbl_pos_conv = switch tbl_pos
    "Top Right"    => position.top_right
    "Top Left"     => position.top_left
    "Bottom Right" => position.bottom_right
    "Bottom Left"  => position.bottom_left
    "Middle Right" => position.middle_right
    => position.middle_left

tbl_sz_conv = switch tbl_size
    "tiny"  => size.tiny
    "small" => size.small
    => size.normal

// ─────────────────────────────────────────────────────────
//  THEME + PALETTE  (house canonical block — colors only)
//  Source of truth: docs/superpowers/specs/2026-05-06-unified-pine-palette-block.pine
//  The existing "Table Theme" (Dark/Light) dropdown drives IS_LIGHT_MODE below,
//  so every table AND chart object follows one theme control.
// ─────────────────────────────────────────────────────────
// Mode resolution. Palette state is `var` with literal defaults, assigned ONCE
// on barstate.isfirst (reading chart.bg_color every bar would grow max_bars_back).
var bool IS_LIGHT_MODE = false
var color P_LONG_BASE   = #06b6d4  // cyan/teal (win / positive / bull) — Fractal Sweep reward color, not emerald
var color P_SHORT_BASE  = #f87171  // red      (loss / negative / bear)
var color P_WARN_BASE   = #fbbf24  // amber    (extended / caution)
var color P_INFO_BASE   = #38bdf8  // sky      (partial / reward zone)
var color P_ACCENT_BASE = #a78bfa  // violet
var color P_STRUCT_BASE = #cbd5e1  // slate    (borders / muted / entry)
var color P_INK         = #f1f5f9  // label/table text
var color P_SURFACE     = #334155  // pill/table bg — always slate-700 in BOTH modes
var color P_ON_SURFACE  = #f1f5f9  // text on P_SURFACE — always slate-100

if barstate.isfirst
    // Follow the existing Dark/Light dropdown (no Auto option in this indicator).
    IS_LIGHT_MODE := tbl_theme == "Light"
    P_LONG_BASE   := IS_LIGHT_MODE ? #0891b2 : #06b6d4
    P_SHORT_BASE  := IS_LIGHT_MODE ? #b91c1c : #f87171
    P_WARN_BASE   := IS_LIGHT_MODE ? #b45309 : #fbbf24
    P_INFO_BASE   := IS_LIGHT_MODE ? #0369a1 : #38bdf8
    P_ACCENT_BASE := IS_LIGHT_MODE ? #6d28d9 : #a78bfa
    P_STRUCT_BASE := IS_LIGHT_MODE ? #475569 : #cbd5e1
    P_INK         := IS_LIGHT_MODE ? #0f172a : #f1f5f9

// Tier helpers — opacity tiers (0 / 25 / 60 / 85 / 95)
tier_ink(color c)     => color.new(c, 0)
tier_strong(color c)  => color.new(c, 25)
tier_mid(color c)     => color.new(c, 60)
tier_soft(color c)    => color.new(c, 85)
tier_whisper(color c) => color.new(c, 95)

// Composite resolvers — drawing/table code reads only these
pal_long_ink()      => tier_ink(P_LONG_BASE)
pal_long_strong()   => tier_strong(P_LONG_BASE)
pal_long_mid()      => tier_mid(P_LONG_BASE)
pal_long_soft()     => tier_soft(P_LONG_BASE)
pal_short_ink()     => tier_ink(P_SHORT_BASE)
pal_short_strong()  => tier_strong(P_SHORT_BASE)
pal_short_mid()     => tier_mid(P_SHORT_BASE)
pal_short_soft()    => tier_soft(P_SHORT_BASE)
pal_warn_ink()      => tier_ink(P_WARN_BASE)
pal_warn_strong()   => tier_strong(P_WARN_BASE)
pal_warn_mid()      => tier_mid(P_WARN_BASE)
pal_warn_soft()     => tier_soft(P_WARN_BASE)
pal_info_ink()      => tier_ink(P_INFO_BASE)
pal_info_strong()   => tier_strong(P_INFO_BASE)
pal_info_mid()      => tier_mid(P_INFO_BASE)
pal_info_soft()     => tier_soft(P_INFO_BASE)
pal_struct_ink()    => tier_ink(P_STRUCT_BASE)
pal_struct_strong() => tier_strong(P_STRUCT_BASE)
pal_struct_mid()    => tier_mid(P_STRUCT_BASE)
pal_struct_soft()   => tier_soft(P_STRUCT_BASE)
pal_ink()            => P_INK
pal_surface()        => P_SURFACE
pal_surface_strong() => tier_strong(P_SURFACE)
pal_on_surface()     => P_ON_SURFACE
pal_table_header_bg() => #0f172a
pal_table_text()      => P_ON_SURFACE
pal_table_muted()     => color.new(P_ON_SURFACE, 50)
// Brighter 300-tier for numbers on the always-dark table surface (700-tier reads dark-on-dark)
pal_table_long()  => #67e8f9
pal_table_short() => #fca5a5
pal_table_warn()  => #fcd34d
pal_table_info()  => #93c5fd

// ── On-chart label helpers ───────────────────────────────────────────────────
// Chart labels/pills sit over the chart (white in Light mode). Text is ALWAYS
// dark ink so it reads on the faint pill / white bg; pill backgrounds are the
// WHISPER tier (95% transp) — a subtle colored tint, never a loud chip.
pal_label_text()      => #0f172a                 // always-dark label text
pal_pill_long()       => tier_whisper(P_LONG_BASE)
pal_pill_short()      => tier_whisper(P_SHORT_BASE)
pal_pill_warn()       => tier_whisper(P_WARN_BASE)
pal_pill_info()       => tier_whisper(P_INFO_BASE)
pal_pill_struct()     => tier_whisper(P_STRUCT_BASE)

// ── Table style → Fractal Sweep "Today's Scorecard" look ─────────────────────
// The scorecard is an ALWAYS-DARK slate card in BOTH light & dark chart themes
// (like a tooltip), with ALWAYS-LIGHT text — this guarantees the text is always
// readable on the card regardless of theme. We copy that exactly: two alternating
// dark slate tones + white/bright text. No per-cell accent backgrounds — color
// lives in the TEXT only (labels muted, values white, positive = cyan / neg = red).
bool  isDark    = not IS_LIGHT_MODE
color SB_DEEP   = color.new(#0f172a, 0)   // _sb_bg  — deep row  (both themes)
color SB_ALT    = color.new(#334155, 0)   // _sb_alt — lighter row (both themes)
color th_hbg    = SB_ALT                   // header band
color th_row_bg = SB_DEEP                  // data rows
color th_sum_bg = SB_ALT                   // summary rows
color th_hourly = SB_DEEP
color th_text   = color.white              // values — always light on the dark card
color th_muted  = color.new(#cbd5e1, 0)    // row labels — light slate, readable

// Resolve tracker timezone
string tbl_tz = tbl_tz_opt == "Auto (Chart/Exchange)" ? syminfo.timezone : tbl_tz_opt

// ─────────────────────────────────────────────────────────
//  SESSION
// ─────────────────────────────────────────────────────────
inSession         = not na(time(timeframe.period, sess_string, "America/Chicago"))
sessionJustOpened = inSession and not inSession[1]

// Trading windows
int _ct_hour = hour(time, "America/Chicago")
bool hourOk = true
if use_windows
    bool in_7pm  = win_7pm  and (_ct_hour >= 19 and _ct_hour <= 20)
    bool in_1am  = win_1am  and (_ct_hour >= 1  and _ct_hour <= 1)
    bool in_6am  = win_6am  and (_ct_hour >= 6  and _ct_hour <= 10)
    bool in_12pm = win_12pm and (_ct_hour >= 12 and _ct_hour <= 13)
    hourOk := in_7pm or in_1am or in_6am or in_12pm

// ─────────────────────────────────────────────────────────
//  5-MIN FVG STORAGE
// ─────────────────────────────────────────────────────────
var float[] fvg5_top    = array.new_float(0)
var float[] fvg5_bot    = array.new_float(0)
var int[]   fvg5_dir    = array.new_int(0)
var box[]   fvg5_box    = array.new_box(0)
var label[] fvg5_llabel = array.new_label(0)
var label[] fvg5_rlabel = array.new_label(0)
var box[]   fvg1_boxes  = array.new_box(0)

// ── CURRENT NESTED PAIR — the single "1 unmitigated 5m FVG with a 1m FVG nested
//    inside it" illustration. Decoupled from the trade-signal gates: it tracks
//    the most recent nesting geometry, regardless of cooldown/window/block.
var box   np_htf_box = na          // the 5-min host zone box
var box   np_ltf_box = na          // the 1-min nested FVG box
var int   np_left    = na          // left bar_index of the pair (formation)
var float np_htf_top = na          // host edges (for mitigation tracking)
var float np_htf_bot = na
var int   np_dir     = 0           // 1 bull / -1 bear (0 = none active)
var float np_ltf_top = na          // captured 1-min edges (set at detection)
var float np_ltf_bot = na
var bool  np_pending = false       // a fresh nesting detected this bar

// ─────────────────────────────────────────────────────────
//  TRADE LOG ARRAYS
// ─────────────────────────────────────────────────────────
var int[]    tlog_num    = array.new_int(0)
var string[] tlog_date   = array.new_string(0)
var int[]    tlog_ts     = array.new_int(0)
var string[] tlog_time   = array.new_string(0)
var string[] tlog_dir    = array.new_string(0)
var float[]  tlog_entry  = array.new_float(0)
var float[]  tlog_stop   = array.new_float(0)
var float[]  tlog_part   = array.new_float(0)
var float[]  tlog_target = array.new_float(0)
var float[]  tlog_ext    = array.new_float(0)
var string[] tlog_result = array.new_string(0)
var float[]  tlog_pnl    = array.new_float(0)

// Hourly arrays
var int[] active_hours = array.new_int(0)
var int[]   hr_count   = array.new_int(24, 0)
var int[]   hr_wins    = array.new_int(24, 0)
var int[]   hr_losses  = array.new_int(24, 0)
var int[]   hr_partial = array.new_int(24, 0)
var float[] hr_pnl     = array.new_float(24, 0.0)

// Trade UDT
type Trade
    int    dir
    float  entry
    float  stop
    float  target
    float  part
    float  ext
    int    idx
    bool   partial_hit
    bool   target_hit
    int    qty
    int    qty_part
    int    qty_tgt
    int    qty_run
    int    hr
    int    num

var array<Trade> pendingTrades = array.new<Trade>()
var array<Trade> openTrades    = array.new<Trade>()

// Stats
var int   stat_total     = 0
var int   stat_wins      = 0
var int   stat_losses    = 0
var int   stat_partials  = 0
var float stat_total_pnl = 0.0
var float stat_daily_pnl = 0.0
var int   stat_streak    = 0
var int   sig_count      = 0

// Cooldown
var int last_bull_bar   = -999
var int last_bear_bar   = -999
var int last_signal_bar = -999

// ─────────────────────────────────────────────────────────
//  TRADING GATES
// ─────────────────────────────────────────────────────────
float daily_loss_usd = stat_daily_pnl * tbl_usd_per_pt
bool  dll_ok         = not dll_enabled or daily_loss_usd > -math.abs(dll_usd)
bool  tradingAllowed = inSession and dll_ok and hourOk

// ─────────────────────────────────────────────────────────
//  PURGE ON SESSION OPEN
// ─────────────────────────────────────────────────────────
if sessionJustOpened
    if array.size(fvg5_box) > 0
        for i = 0 to array.size(fvg5_box) - 1
            box.delete(array.get(fvg5_box, i))
    if array.size(fvg5_llabel) > 0
        for i = 0 to array.size(fvg5_llabel) - 1
            label.delete(array.get(fvg5_llabel, i))
    if array.size(fvg5_rlabel) > 0
        for i = 0 to array.size(fvg5_rlabel) - 1
            label.delete(array.get(fvg5_rlabel, i))
    if array.size(fvg1_boxes) > 0
        for i = 0 to array.size(fvg1_boxes) - 1
            box.delete(array.get(fvg1_boxes, i))
    array.clear(fvg5_top)
    array.clear(fvg5_bot)
    array.clear(fvg5_dir)
    array.clear(fvg5_box)
    array.clear(fvg5_llabel)
    array.clear(fvg5_rlabel)
    array.clear(fvg1_boxes)
    array.clear(openTrades)
    // Clear the current-nested-pair drawing on session open.
    box.delete(np_htf_box)
    box.delete(np_ltf_box)
    np_htf_box := na
    np_ltf_box := na
    np_dir     := 0
    np_pending := false
    last_bull_bar   := -999
    last_bear_bar   := -999
    last_signal_bar := -999
    stat_daily_pnl  := 0.0

bool _shared_ok       = (bar_index - last_signal_bar) >= cooldown_bars
bool bull_cooldown_ok = _shared_ok and (bar_index - last_bull_bar) >= cooldown_bars
bool bear_cooldown_ok = _shared_ok and (bar_index - last_bear_bar) >= cooldown_bars

// ─────────────────────────────────────────────────────────
//  FORCE CLOSE HELPER
// ─────────────────────────────────────────────────────────
forceCloseAll(float px) =>
    float pnlD = 0.0
    int   wD = 0, lD = 0, pD = 0
    int   stk = stat_streak
    if array.size(openTrades) > 0
        for i = 0 to array.size(openTrades) - 1
            Trade tr = array.get(openTrades, i)
            int   remn = tr.partial_hit ? (tr.target_hit ? tr.qty_run : tr.qty_tgt + tr.qty_run) : tr.qty
            float leg  = tr.dir == 1 ? remn * (px - tr.entry) : remn * (tr.entry - px)
            array.set(tlog_pnl, tr.idx, array.get(tlog_pnl, tr.idx) + leg)
            array.set(hr_pnl,   tr.hr,  array.get(hr_pnl,   tr.hr)  + leg)
            pnlD += leg
            float net = array.get(tlog_pnl, tr.idx)
            if tr.target_hit
                array.set(tlog_result, tr.idx, "✅ Win")
                wD  += 1
                stk  := stk < 0 ? 1 : stk + 1
                array.set(hr_wins, tr.hr, array.get(hr_wins, tr.hr) + 1)
            else if net >= 0
                array.set(tlog_result, tr.idx, "🔵 Partial")
                pD  += 1
                stk  := stk < 0 ? 1 : stk + 1
                array.set(hr_partial, tr.hr, array.get(hr_partial, tr.hr) + 1)
            else
                array.set(tlog_result, tr.idx, "❌ Loss")
                lD  += 1
                stk  := stk > 0 ? -1 : stk - 1
                array.set(hr_losses, tr.hr, array.get(hr_losses, tr.hr) + 1)
        array.clear(openTrades)
    [pnlD, wD, lD, pD, stk]

// ─────────────────────────────────────────────────────────
//  OUTCOME DETECTION
// ─────────────────────────────────────────────────────────
bool outcome_entry       = false  // a pending order just filled
bool outcome_emergency   = false  // per-trade max loss breached
bool outcome_partial     = false
bool outcome_target      = false
bool outcome_partial_win = false
bool outcome_be          = false
bool outcome_loss        = false

// ── Per-trade max loss emergency check ──────────────────
if barstate.isconfirmed and max_trade_risk_usd > 0 and array.size(openTrades) > 0
    for i = 0 to array.size(openTrades) - 1
        Trade tr = array.get(openTrades, i)
        float unreal_pts = tr.dir == 1 ? (close - tr.entry) : (tr.entry - close)
        int   open_qty   = tr.partial_hit ? (tr.qty_tgt + tr.qty_run) : tr.qty
        float unreal_usd = unreal_pts * open_qty * tbl_usd_per_pt

        // Trigger emergency exit if the floating loss breaches our dynamic ceiling
        if unreal_usd < -math.abs(max_trade_risk_usd)
            float leg = tr.dir == 1 ? float(open_qty) * (close - tr.entry) : float(open_qty) * (tr.entry - close)
            float part_banked = tr.partial_hit ? float(tr.qty_part) * (tr.dir == 1 ? tr.part - tr.entry : tr.entry - tr.part) : 0.0
            float total_pnl = part_banked + leg
            array.set(tlog_result, tr.idx, "❌ Loss")
            array.set(tlog_pnl,    tr.idx, total_pnl)
            stat_total_pnl += total_pnl
            stat_daily_pnl += total_pnl
            stat_losses    += 1
            stat_streak     := stat_streak > 0 ? -1 : stat_streak - 1
            array.set(hr_losses, tr.hr, array.get(hr_losses, tr.hr) + 1)
            array.set(hr_pnl,    tr.hr, array.get(hr_pnl,    tr.hr) + total_pnl)
            outcome_emergency := true
        if outcome_emergency
            array.clear(openTrades)
            break

// ── Pending-order fills ──────────────────────────────────────────────────────
if barstate.isconfirmed
    int pi = 0
    while pi < array.size(pendingTrades)
        Trade pt = array.get(pendingTrades, pi)
        bool fill = pt.dir == 1 ? low <= pt.entry : high >= pt.entry
        if fill
            if trade_mode == "Force close trade on new signal" and array.size(openTrades) > 0
                [fpd, fwd, fld, fpp, fstk] = forceCloseAll(close)
                stat_total_pnl += fpd
                stat_daily_pnl += fpd
                stat_wins      += fwd
                stat_losses    += fld
                stat_partials  += fpp
                stat_streak     := fstk
            pt.hr := hour(time, tbl_tz)
            array.push(tlog_num,    pt.num)
            array.push(tlog_date,   str.format_time(time, "MM/dd", tbl_tz))
            array.push(tlog_ts,     time)
            array.push(tlog_time,   str.format_time(time, "HH:mm", tbl_tz))
            array.push(tlog_dir,    pt.dir == 1 ? "▲ Bull" : "▼ Bear")
            array.push(tlog_entry,  pt.entry)
            array.push(tlog_stop,   pt.stop)
            array.push(tlog_part,   pt.part)
            array.push(tlog_target, pt.target)
            array.push(tlog_ext,    pt.ext)
            array.push(tlog_result, "⏳ Open")
            array.push(tlog_pnl,    0.0)
            pt.idx := array.size(tlog_time) - 1
            stat_total += 1
            outcome_entry := true
            array.set(hr_count, pt.hr, array.get(hr_count, pt.hr) + 1)
            array.push(openTrades, pt)
            array.remove(pendingTrades, pi)
        else if invalidate_partial and (pt.dir == 1 ? high >= pt.part : low <= pt.part)
            array.remove(pendingTrades, pi)
        else
            pi += 1

int oti = 0
while barstate.isconfirmed and oti < array.size(openTrades)
    Trade tr = array.get(openTrades, oti)
    bool closed = false
    if tr.dir == 1
        if not tr.partial_hit
            if low <= tr.stop
                float lleg = tr.qty * (tr.stop - tr.entry)
                array.set(tlog_result, tr.idx, "❌ Loss")
                array.set(tlog_pnl,    tr.idx, lleg)
                stat_total_pnl += lleg
                stat_daily_pnl += lleg
                stat_losses    += 1
                stat_streak     := stat_streak > 0 ? -1 : stat_streak - 1
                closed          := true
                outcome_loss    := true
                array.set(hr_losses, tr.hr, array.get(hr_losses, tr.hr) + 1)
                array.set(hr_pnl,    tr.hr, array.get(hr_pnl,    tr.hr) + lleg)
            else if high >= tr.part
                float pleg = tr.qty_part * (tr.part - tr.entry)
                tr.partial_hit := true
                if pos_be_at_partial
                    tr.stop := tr.entry
                array.set(tlog_pnl, tr.idx, array.get(tlog_pnl, tr.idx) + pleg)
                stat_total_pnl += pleg
                stat_daily_pnl += pleg
                array.set(hr_pnl, tr.hr, array.get(hr_pnl, tr.hr) + pleg)
                if tr.qty_tgt + tr.qty_run == 0
                    array.set(tlog_result, tr.idx, "🔵 Partial")
                    stat_partials       += 1
                    stat_streak          := stat_streak < 0 ? 1 : stat_streak + 1
                    closed               := true
                    outcome_partial_win  := true
                    array.set(hr_partial, tr.hr, array.get(hr_partial, tr.hr) + 1)
                else
                    array.set(tlog_result, tr.idx, "⏳ Partial")
                    outcome_partial := true
            else if high >= tr.target
                float wleg = tr.qty * (tr.target - tr.entry)
                array.set(tlog_result, tr.idx, "✅ Win")
                array.set(tlog_pnl,    tr.idx, wleg)
                stat_total_pnl += wleg
                stat_daily_pnl += wleg
                stat_wins      += 1
                stat_streak     := stat_streak < 0 ? 1 : stat_streak + 1
                closed          := true
                outcome_target  := true
                array.set(hr_wins, tr.hr, array.get(hr_wins, tr.hr) + 1)
                array.set(hr_pnl,  tr.hr, array.get(hr_pnl,  tr.hr) + wleg)
        if not closed and tr.partial_hit and not tr.target_hit
            if high >= tr.target
                float tleg = tr.qty_tgt * (tr.target - tr.entry)
                tr.target_hit := true
                array.set(tlog_pnl, tr.idx, array.get(tlog_pnl, tr.idx) + tleg)
                stat_total_pnl += tleg
                stat_daily_pnl += tleg
                array.set(hr_pnl, tr.hr, array.get(hr_pnl, tr.hr) + tleg)
                if tr.qty_run == 0
                    array.set(tlog_result, tr.idx, "✅ Win")
                    stat_wins      += 1
                    stat_streak     := stat_streak < 0 ? 1 : stat_streak + 1
                    closed          := true
                    outcome_target  := true
                    array.set(hr_wins, tr.hr, array.get(hr_wins, tr.hr) + 1)
                else
                    array.set(tlog_result, tr.idx, "⏳ Win")
            else if low <= tr.stop
                int   rem  = tr.qty_tgt + tr.qty_run
                float sleg = rem * (tr.stop - tr.entry)
                array.set(tlog_pnl, tr.idx, array.get(tlog_pnl, tr.idx) + sleg)
                stat_total_pnl += sleg
                stat_daily_pnl += sleg
                array.set(hr_pnl, tr.hr, array.get(hr_pnl, tr.hr) + sleg)
                closed := true
                if array.get(tlog_pnl, tr.idx) >= 0
                    array.set(tlog_result, tr.idx, "🔵 Partial")
                    stat_partials  += 1
                    stat_streak     := stat_streak < 0 ? 1 : stat_streak + 1
                    outcome_be      := true
                    array.set(hr_partial, tr.hr, array.get(hr_partial, tr.hr) + 1)
                else
                    array.set(tlog_result, tr.idx, "❌ Loss")
                    stat_losses    += 1
                    stat_streak     := stat_streak > 0 ? -1 : stat_streak - 1
                    outcome_loss    := true
                    array.set(hr_losses, tr.hr, array.get(hr_losses, tr.hr) + 1)
        if not closed and tr.target_hit
            if high >= tr.ext
                float xleg = tr.qty_run * (tr.ext - tr.entry)
                array.set(tlog_result, tr.idx, "✅ Win")
                array.set(tlog_pnl,    tr.idx, array.get(tlog_pnl, tr.idx) + xleg)
                stat_total_pnl += xleg
                stat_daily_pnl += xleg
                stat_wins      += 1
                stat_streak     := stat_streak < 0 ? 1 : stat_streak + 1
                closed          := true
                outcome_target  := true
                array.set(hr_wins, tr.hr, array.get(hr_wins, tr.hr) + 1)
                array.set(hr_pnl,  tr.hr, array.get(hr_pnl,  tr.hr) + xleg)
            else if low <= tr.stop
                float xleg = tr.qty_run * (tr.stop - tr.entry)
                array.set(tlog_pnl, tr.idx, array.get(tlog_pnl, tr.idx) + xleg)
                stat_total_pnl += xleg
                stat_daily_pnl += xleg
                array.set(hr_pnl, tr.hr, array.get(hr_pnl, tr.hr) + xleg)
                array.set(tlog_result, tr.idx, "✅ Win")
                stat_wins      += 1
                stat_streak     := stat_streak < 0 ? 1 : stat_streak + 1
                closed          := true
                outcome_target  := true
                array.set(hr_wins, tr.hr, array.get(hr_wins, tr.hr) + 1)
    else if tr.dir == -1
        if not tr.partial_hit
            if high >= tr.stop
                float lleg = tr.qty * (tr.entry - tr.stop)
                array.set(tlog_result, tr.idx, "❌ Loss")
                array.set(tlog_pnl,    tr.idx, lleg)
                stat_total_pnl += lleg
                stat_daily_pnl += lleg
                stat_losses    += 1
                stat_streak     := stat_streak > 0 ? -1 : stat_streak - 1
                closed          := true
                outcome_loss    := true
                array.set(hr_losses, tr.hr, array.get(hr_losses, tr.hr) + 1)
                array.set(hr_pnl,    tr.hr, array.get(hr_pnl,    tr.hr) + lleg)
            else if low <= tr.part
                float pleg = tr.qty_part * (tr.entry - tr.part)
                tr.partial_hit := true
                if pos_be_at_partial
                    tr.stop := tr.entry
                array.set(tlog_pnl, tr.idx, array.get(tlog_pnl, tr.idx) + pleg)
                stat_total_pnl += pleg
                stat_daily_pnl += pleg
                array.set(hr_pnl, tr.hr, array.get(hr_pnl, tr.hr) + pleg)
                if tr.qty_tgt + tr.qty_run == 0
                    array.set(tlog_result, tr.idx, "🔵 Partial")
                    stat_partials       += 1
                    stat_streak          := stat_streak < 0 ? 1 : stat_streak + 1
                    closed               := true
                    outcome_partial_win  := true
                    array.set(hr_partial, tr.hr, array.get(hr_partial, tr.hr) + 1)
                else
                    array.set(tlog_result, tr.idx, "⏳ Partial")
                    outcome_partial := true
            else if low <= tr.target
                float wleg = tr.qty * (tr.entry - tr.target)
                array.set(tlog_result, tr.idx, "✅ Win")
                array.set(tlog_pnl,    tr.idx, wleg)
                stat_total_pnl += wleg
                stat_daily_pnl += wleg
                stat_wins      += 1
                stat_streak     := stat_streak < 0 ? 1 : stat_streak + 1
                closed          := true
                outcome_target  := true
                array.set(hr_wins, tr.hr, array.get(hr_wins, tr.hr) + 1)
                array.set(hr_pnl,  tr.hr, array.get(hr_pnl,  tr.hr) + wleg)
        if not closed and tr.partial_hit and not tr.target_hit
            if low <= tr.target
                float tleg = tr.qty_tgt * (tr.entry - tr.target)
                tr.target_hit := true
                array.set(tlog_pnl, tr.idx, array.get(tlog_pnl, tr.idx) + tleg)
                stat_total_pnl += tleg
                stat_daily_pnl += tleg
                array.set(hr_pnl, tr.hr, array.get(hr_pnl, tr.hr) + tleg)
                if tr.qty_run == 0
                    array.set(tlog_result, tr.idx, "✅ Win")
                    stat_wins      += 1
                    stat_streak     := stat_streak < 0 ? 1 : stat_streak + 1
                    closed          := true
                    outcome_target  := true
                    array.set(hr_wins, tr.hr, array.get(hr_wins, tr.hr) + 1)
                else
                    array.set(tlog_result, tr.idx, "⏳ Win")
            else if high >= tr.stop
                int   rem  = tr.qty_tgt + tr.qty_run
                float sleg = rem * (tr.entry - tr.stop)
                array.set(tlog_pnl, tr.idx, array.get(tlog_pnl, tr.idx) + sleg)
                stat_total_pnl += sleg
                stat_daily_pnl += sleg
                array.set(hr_pnl, tr.hr, array.get(hr_pnl, tr.hr) + sleg)
                closed := true
                if array.get(tlog_pnl, tr.idx) >= 0
                    array.set(tlog_result, tr.idx, "🔵 Partial")
                    stat_partials  += 1
                    stat_streak     := stat_streak < 0 ? 1 : stat_streak + 1
                    outcome_be      := true
                    array.set(hr_partial, tr.hr, array.get(hr_partial, tr.hr) + 1)
                else
                    array.set(tlog_result, tr.idx, "❌ Loss")
                    stat_losses    += 1
                    stat_streak     := stat_streak > 0 ? -1 : stat_streak - 1
                    outcome_loss    := true
                    array.set(hr_losses, tr.hr, array.get(hr_losses, tr.hr) + 1)
        if not closed and tr.target_hit
            if low <= tr.ext
                float xleg = tr.qty_run * (tr.entry - tr.ext)
                array.set(tlog_result, tr.idx, "✅ Win")
                array.set(tlog_pnl,    tr.idx, array.get(tlog_pnl, tr.idx) + xleg)
                stat_total_pnl += xleg
                stat_daily_pnl += xleg
                stat_wins      += 1
                stat_streak     := stat_streak < 0 ? 1 : stat_streak + 1
                closed          := true
                outcome_target  := true
                array.set(hr_wins, tr.hr, array.get(hr_wins, tr.hr) + 1)
                array.set(hr_pnl,  tr.hr, array.get(hr_pnl,  tr.hr) + xleg)
            else if high >= tr.stop
                float xleg = tr.qty_run * (tr.entry - tr.stop)
                array.set(tlog_pnl, tr.idx, array.get(tlog_pnl, tr.idx) + xleg)
                stat_total_pnl += xleg
                stat_daily_pnl += xleg
                array.set(hr_pnl, tr.hr, array.get(hr_pnl, tr.hr) + xleg)
                array.set(tlog_result, tr.idx, "✅ Win")
                stat_wins      += 1
                stat_streak     := stat_streak < 0 ? 1 : stat_streak + 1
                closed          := true
                outcome_target  := true
                array.set(hr_wins, tr.hr, array.get(hr_wins, tr.hr) + 1)
    if closed
        array.remove(openTrades, oti)
    else
        oti += 1

// ─────────────────────────────────────────────────────────
//  5-MIN BOUNDARY DETECTION
// ─────────────────────────────────────────────────────────
is_new_5m = timeframe.change("5")

var float running5High = na
var float running5Low  = na
var float h5_c0 = na,  var float l5_c0 = na
var float h5_c1 = na,  var float l5_c1 = na
var float h5_c2 = na,  var float l5_c2 = na

if is_new_5m
    h5_c2 := h5_c1
    l5_c2 := l5_c1
    h5_c1 := h5_c0
    l5_c1 := l5_c0
    h5_c0 := running5High
    l5_c0 := running5Low
    running5High := high
    running5Low  := low
else
    running5High := na(running5High) ? high : math.max(running5High, high)
    running5Low  := na(running5Low)  ? low  : math.min(running5Low,  low)

// ─────────────────────────────────────────────────────────
//  ADD 5-MIN FVG ZONE
//  FIX: bgcolor uses the input color directly (no color.new wrapper)
//  so the user's opacity setting in the color picker is respected.
// ─────────────────────────────────────────────────────────
f_add5(float ztop, float zbot, int zdir, string lbl, color bcol) =>
    array.push(fvg5_top, ztop)
    array.push(fvg5_bot, zbot)
    array.push(fvg5_dir, zdir)
    float mid = (ztop + zbot) / 2
    // MINIMAL UI: 5-min FVG zones are NOT drawn at detection — that produced a wall
    // of wide, ever-stretching bands. We only store the zone data here (top/bot/dir);
    // the box is drawn later, ONLY for the specific zone a 1-min FVG nests into (see
    // the nested-check blocks). These placeholder box/labels exist solely to keep the
    // parallel-array index alignment used by mitigation/purge. They are invisible
    // (na colors, zero width at the current bar) and never stretched.
    array.push(fvg5_box,    box.new(bar_index, ztop, bar_index, zbot, border_color=color.new(color.gray, 100), bgcolor=color.new(color.gray, 100)))
    array.push(fvg5_llabel, label.new(bar_index, mid, "", style=label.style_none))
    array.push(fvg5_rlabel, label.new(bar_index, mid, "", style=label.style_none))

// ─────────────────────────────────────────────────────────
//  DETECT 5-MIN FVGS
// ─────────────────────────────────────────────────────────
if is_new_5m and inSession and not na(h5_c2)
    float gap5_bull = l5_c0 - h5_c2
    float min5_bull = h5_c2 * (fvg5_min_bp / 10000.0)
    if l5_c0 > h5_c2 and gap5_bull >= min5_bull
        f_add5(l5_c0, h5_c2, 1, "BISI", fvg5_bull_col)

    float gap5_bear = l5_c2 - h5_c0
    float min5_bear = h5_c0 * (fvg5_min_bp / 10000.0)
    if h5_c0 < l5_c2 and gap5_bear >= min5_bear
        f_add5(l5_c2, h5_c0, -1, "SIBI", fvg5_bear_col)

// (5-min FVG boxes are no longer stretched — they draw only when nested into.)

// ─────────────────────────────────────────────────────────
//  MITIGATION
// ─────────────────────────────────────────────────────────
if fvg5_mitigated and array.size(fvg5_top) > 0
    int i = 0
    while i < array.size(fvg5_top)
        bool mit = (array.get(fvg5_dir, i) == 1  and close < array.get(fvg5_bot, i)) or
                   (array.get(fvg5_dir, i) == -1 and close > array.get(fvg5_top, i))
        if mit
            array.remove(fvg5_top, i)
            array.remove(fvg5_bot, i)
            array.remove(fvg5_dir, i)
            box.delete(array.remove(fvg5_box, i))
            label.delete(array.remove(fvg5_llabel, i))
            label.delete(array.remove(fvg5_rlabel, i))
        else
            i += 1

// ─────────────────────────────────────────────────────────
//  1-MIN FVG + NESTED CHECK
// ─────────────────────────────────────────────────────────
bool bullNested = false
bool bearNested = false

if barstate.isconfirmed and tradingAllowed
    // ── Bullish ──────────────────────────────────────────
    float gap1_bull = low - high[2]
    float min1_bull = high[2] * (fvg1_min_bp / 10000.0)
    if low > high[2] and gap1_bull >= min1_bull
        float top1 = low
        float bot1 = high[2]
        bool nested = false
        float host_top = na
        float host_bot = na
        if array.size(fvg5_top) > 0
            for i = 0 to array.size(fvg5_top) - 1
                if array.get(fvg5_dir, i) == 1
                    float prox = array.get(fvg5_bot, i) * (proximity_bp / 10000.0)
                    if bot1 >= (array.get(fvg5_bot, i) - prox) and top1 <= (array.get(fvg5_top, i) + prox)
                        nested := true
                        host_top := array.get(fvg5_top, i)
                        host_bot := array.get(fvg5_bot, i)
                        break
        // Capture the nesting geometry for the standalone "current nested pair"
        // drawing — independent of the trade gates below.
        if nested
            np_pending := true
            np_dir     := 1
            np_htf_top := host_top
            np_htf_bot := host_bot
            np_ltf_top := top1
            np_ltf_bot := bot1
        bool bull_blocked = trade_mode == "Block new trades until open trade closes" and (array.size(openTrades) + array.size(pendingTrades) > 0)
        if nested and bull_cooldown_ok and not bull_blocked
            if trade_mode == "Force close trade on new signal" and array.size(openTrades) > 0
                [fpd, fwd, fld, fpp, fstk] = forceCloseAll(close)
                stat_total_pnl += fpd
                stat_daily_pnl += fpd
                stat_wins      += fwd
                stat_losses    += fld
                stat_partials  += fpp
                stat_streak     := fstk
            sig_count        += 1
            bullNested        := true
            last_bull_bar     := bar_index
            last_signal_bar   := bar_index
            stat_total        += 1
            int   _bhr = hour(time, tbl_tz)
            float _be  = bot1
            // Dynamic basis point calculations (0.1% = 10 bps)
            float stop_distance    = _be * (rr_stop_pct / 100.0)
            float partial_distance = _be * (rr_partial_pct / 100.0)
            float target_distance  = _be * (rr_target_pct / 100.0)
            float ext_distance     = _be * (rr_ext_pct / 100.0)

            float _bs  = _be - stop_distance
            float _bp  = _be + partial_distance
            float _bt  = _be + target_distance
            float _bx  = _be + ext_distance

            // AUTOMATIC & DYNAMIC POSITION SIZING
            float risk_per_contract = stop_distance * val_per_point
            int dynamic_qty = math.max(3, math.floor(max_trade_risk_usd / risk_per_contract))

            int _bqp = math.max(1, math.floor(dynamic_qty / 3))
            int _bqt = _bqp
            int _bq_run = dynamic_qty - _bqp - _bqt

            array.push(tlog_num,    sig_count)
            array.push(tlog_date,   str.format_time(time, "MM/dd", tbl_tz))
            array.push(tlog_ts,     time)
            array.push(tlog_time,   str.format_time(time, "HH:mm", tbl_tz))
            array.push(tlog_dir,    "▲ Bull")
            array.push(tlog_entry,  _be)
            array.push(tlog_stop,   _bs)
            array.push(tlog_part,   _bp)
            array.push(tlog_target, _bt)
            array.push(tlog_ext,    _bx)
            array.push(tlog_result, "⏳ Open")
            array.push(tlog_pnl,    0.0)

            if fvg1_entry == "Immediate"
                array.push(openTrades, Trade.new(dir=1, entry=_be, stop=_bs, target=_bt, part=_bp, ext=_bx, idx=array.size(tlog_time)-1, partial_hit=false, target_hit=false, qty=dynamic_qty, qty_part=_bqp, qty_tgt=_bqt, qty_run=dynamic_qty-_bqp-_bqt, hr=_bhr, num=sig_count))
                array.set(hr_count, _bhr, array.get(hr_count, _bhr) + 1)
            else
                array.push(pendingTrades, Trade.new(dir=1, entry=_be, stop=_bs, target=_bt, part=_bp, ext=_bx, idx=-1, partial_hit=false, target_hit=false, qty=dynamic_qty, qty_part=_bqp, qty_tgt=_bqt, qty_run=dynamic_qty-_bqp-_bqt, hr=0, num=sig_count))
            // (Nested-pair drawing is handled separately below, decoupled from the
            // trade gates — see "CURRENT NESTED PAIR". Nothing drawn here on fire.)
            if rr_show
                int rs = bar_index + 1
                int re = bar_index + 16
                line.new(rs, _be, re, _be, color=rr_entry_col,   width=1, style=line.style_dashed)
                line.new(rs, _bs, re, _bs, color=rr_stop_col,    width=1, style=line.style_dashed)
                line.new(rs, _bp, re, _bp, color=rr_partial_col, width=1, style=line.style_dashed)
                line.new(rs, _bt, re, _bt, color=rr_target_col,  width=2, style=line.style_solid)
                line.new(rs, _bx, re, _bx, color=rr_ext_col,     width=2, style=line.style_solid)
                box.new(rs, _be, re, _bs, border_color=pal_short_mid(), bgcolor=pal_short_soft(), border_width=1)
                box.new(rs, _bt, re, _be, border_color=pal_info_mid(),  bgcolor=pal_info_soft(),  border_width=1)
                box.new(rs, _bx, re, _bt, border_color=pal_warn_mid(),  bgcolor=pal_warn_soft(),  border_width=1)
                // Price-tag pills — off by default (boxes/lines already show the levels).
                if rr_show_pills
                    label.new(re, _bx, "T2 +" + str.tostring(math.round(ext_distance, 2))    + "pts (" + str.tostring(_bq_run) + " MNQ) @ " + str.tostring(math.round(_bx,2)), color=pal_pill_warn(),   textcolor=pal_label_text(), style=label.style_label_left, size=rr_sz)
                    label.new(re, _bt, "T  +" + str.tostring(math.round(target_distance, 2)) + "pts (" + str.tostring(_bqt) + " MNQ) @ " + str.tostring(math.round(_bt,2)), color=pal_pill_info(),   textcolor=pal_label_text(), style=label.style_label_left, size=rr_sz)
                    label.new(re, _bp, "Anchor/BE +" + str.tostring(math.round(partial_distance, 2)) + "pts (" + str.tostring(_bqp) + " MNQ) @ " + str.tostring(math.round(_bp,2)), color=pal_pill_info(),   textcolor=pal_label_text(), style=label.style_label_left, size=rr_sz)
                    label.new(re, _bs, "S  -" + str.tostring(math.round(stop_distance, 2))   + "pts (" + str.tostring(dynamic_qty) + " MNQ) @ " + str.tostring(math.round(_bs,2)), color=pal_pill_short(),  textcolor=pal_label_text(), style=label.style_label_left, size=rr_sz)
                // Compact size badge at entry — the one always-useful tag.
                if rr_show_size
                    label.new(re, _be, "#" + str.tostring(sig_count) + " Enter " + str.tostring(dynamic_qty) + " MNQ @ " + str.tostring(math.round(_be,2)), color=pal_pill_struct(), textcolor=pal_label_text(), style=label.style_label_left, size=rr_sz)

    // ── Bearish ──────────────────────────────────────────
    float gap1_bear = low[2] - high
    float min1_bear = high * (fvg1_min_bp / 10000.0)
    if high < low[2] and gap1_bear >= min1_bear
        float top1 = low[2]
        float bot1 = high
        bool nested = false
        float host_top = na
        float host_bot = na
        if array.size(fvg5_top) > 0
            for i = 0 to array.size(fvg5_top) - 1
                if array.get(fvg5_dir, i) == -1
                    float prox = array.get(fvg5_bot, i) * (proximity_bp / 10000.0)
                    if bot1 >= (array.get(fvg5_bot, i) - prox) and top1 <= (array.get(fvg5_top, i) + prox)
                        nested := true
                        host_top := array.get(fvg5_top, i)
                        host_bot := array.get(fvg5_bot, i)
                        break
        // Capture the nesting geometry for the standalone "current nested pair" drawing.
        if nested
            np_pending := true
            np_dir     := -1
            np_htf_top := host_top
            np_htf_bot := host_bot
            np_ltf_top := top1
            np_ltf_bot := bot1
        bool bear_blocked = trade_mode == "Block new trades until open trade closes" and (array.size(openTrades) + array.size(pendingTrades) > 0)
        if nested and bear_cooldown_ok and not bear_blocked
            if trade_mode == "Force close trade on new signal" and array.size(openTrades) > 0
                [fpd, fwd, fld, fpp, fstk] = forceCloseAll(close)
                stat_total_pnl += fpd
                stat_daily_pnl += fpd
                stat_wins      += fwd
                stat_losses    += fld
                stat_partials  += fpp
                stat_streak     := fstk
            sig_count        += 1
            bearNested        := true
            last_bear_bar     := bar_index
            last_signal_bar   := bar_index
            stat_total        += 1
            int   _thr = hour(time, tbl_tz)
            float _te  = top1
            // Dynamic basis point calculations (0.1% = 10 bps)
            float stop_distance    = _te * (rr_stop_pct / 100.0)
            float partial_distance = _te * (rr_partial_pct / 100.0)
            float target_distance  = _te * (rr_target_pct / 100.0)
            float ext_distance     = _te * (rr_ext_pct / 100.0)

            float _ts  = _te + stop_distance
            float _tp  = _te - partial_distance
            float _tt  = _te - target_distance
            float _tx  = _te - ext_distance

            // AUTOMATIC & DYNAMIC POSITION SIZING
            float risk_per_contract = stop_distance * val_per_point
            int dynamic_qty = math.max(3, math.floor(max_trade_risk_usd / risk_per_contract))

            int _tqp = math.max(1, math.floor(dynamic_qty / 3))
            int _tqt = _tqp
            int _tq_run = dynamic_qty - _tqp - _tqt

            array.push(tlog_num,    sig_count)
            array.push(tlog_date,   str.format_time(time, "MM/dd", tbl_tz))
            array.push(tlog_ts,     time)
            array.push(tlog_time,   str.format_time(time, "HH:mm", tbl_tz))
            array.push(tlog_dir,    "▼ Bear")
            array.push(tlog_entry,  _te)
            array.push(tlog_stop,   _ts)
            array.push(tlog_part,   _tp)
            array.push(tlog_target, _tt)
            array.push(tlog_ext,    _tx)
            array.push(tlog_result, "⏳ Open")
            array.push(tlog_pnl,    0.0)

            if fvg1_entry == "Immediate"
                array.push(openTrades, Trade.new(dir=-1, entry=_te, stop=_ts, target=_tt, part=_tp, ext=_tx, idx=array.size(tlog_time)-1, partial_hit=false, target_hit=false, qty=dynamic_qty, qty_part=_tqp, qty_tgt=_tqt, qty_run=dynamic_qty-_tqp-_tqt, hr=_thr, num=sig_count))
                array.set(hr_count, _thr, array.get(hr_count, _thr) + 1)
            else
                array.push(pendingTrades, Trade.new(dir=-1, entry=_te, stop=_ts, target=_tt, part=_tp, ext=_tx, idx=-1, partial_hit=false, target_hit=false, qty=dynamic_qty, qty_part=_tqp, qty_tgt=_tqt, qty_run=dynamic_qty-_tqp-_tqt, hr=0, num=sig_count))
            // (Nested-pair drawing is handled separately below, decoupled from the
            // trade gates — see "CURRENT NESTED PAIR". Nothing drawn here on fire.)
            if rr_show
                int rs = bar_index + 1
                int re = bar_index + 16
                line.new(rs, _te, re, _te, color=rr_entry_col,   width=1, style=line.style_dashed)
                line.new(rs, _ts, re, _ts, color=rr_stop_col,    width=1, style=line.style_dashed)
                line.new(rs, _tp, re, _tp, color=rr_partial_col, width=1, style=line.style_dashed)
                line.new(rs, _tt, re, _tt, color=rr_target_col,  width=2, style=line.style_solid)
                line.new(rs, _tx, re, _tx, color=rr_ext_col,     width=2, style=line.style_solid)
                box.new(rs, _ts, re, _te, border_color=pal_short_mid(), bgcolor=pal_short_soft(), border_width=1)
                box.new(rs, _te, re, _tt, border_color=pal_info_mid(),  bgcolor=pal_info_soft(),  border_width=1)
                box.new(rs, _tt, re, _tx, border_color=pal_warn_mid(),  bgcolor=pal_warn_soft(),  border_width=1)
                // Price-tag pills — off by default (boxes/lines already show the levels).
                if rr_show_pills
                    label.new(re, _tx, "T2 -" + str.tostring(math.round(ext_distance, 2))    + "pts (" + str.tostring(_tq_run) + " MNQ) @ " + str.tostring(math.round(_tx,2)), color=pal_pill_warn(),   textcolor=pal_label_text(), style=label.style_label_left, size=rr_sz)
                    label.new(re, _tt, "T  -" + str.tostring(math.round(target_distance, 2)) + "pts (" + str.tostring(_tqt) + " MNQ) @ " + str.tostring(math.round(_tt,2)), color=pal_pill_info(),   textcolor=pal_label_text(), style=label.style_label_left, size=rr_sz)
                    label.new(re, _tp, "Anchor/BE -" + str.tostring(math.round(partial_distance, 2)) + "pts (" + str.tostring(_tqp) + " MNQ) @ " + str.tostring(math.round(_tp,2)), color=pal_pill_info(),   textcolor=pal_label_text(), style=label.style_label_left, size=rr_sz)
                    label.new(re, _ts, "S  +" + str.tostring(math.round(stop_distance, 2))   + "pts (" + str.tostring(dynamic_qty) + " MNQ) @ " + str.tostring(math.round(_ts,2)), color=pal_pill_short(),  textcolor=pal_label_text(), style=label.style_label_left, size=rr_sz)
                // Compact size badge at entry — the one always-useful tag.
                if rr_show_size
                    label.new(re, _te, "#" + str.tostring(sig_count) + " Enter " + str.tostring(dynamic_qty) + " MNQ @ " + str.tostring(math.round(_te,2)), color=pal_pill_struct(), textcolor=pal_label_text(), style=label.style_label_left, size=rr_sz)

// ─────────────────────────────────────────────────────────
//  CURRENT NESTED PAIR — draw ONE 5-min unmitigated FVG with the 1-min FVG
//  nested inside it. Decoupled from the trade gates: shows the latest valid
//  nesting geometry, replacing the previous one, and clears when the host 5-min
//  zone mitigates. Colors follow the theme (pal_*), so it works in light/dark.
// ─────────────────────────────────────────────────────────
if fvg5_show and np_pending
    // Replace any previous pair.
    box.delete(np_htf_box)
    box.delete(np_ltf_box)
    color _np_fill_htf = np_dir == 1 ? pal_long_soft()  : pal_short_soft()
    color _np_line_htf = np_dir == 1 ? pal_long_ink()   : pal_short_ink()
    color _np_fill_ltf = np_dir == 1 ? pal_long_mid()   : pal_short_mid()
    np_left    := bar_index - 8
    np_htf_box := box.new(np_left, np_htf_top, bar_index, np_htf_bot,
         border_color=_np_line_htf, bgcolor=_np_fill_htf,
         extend=extend.none, border_width=2, border_style=line.style_solid)
    np_ltf_box := box.new(np_left, np_ltf_top, bar_index, np_ltf_bot,
         border_color=_np_line_htf, bgcolor=_np_fill_ltf,
         extend=extend.none, border_width=1, border_style=line.style_dashed)
    np_pending := false

// Keep the active pair anchored to the current bar; drop it once mitigated.
if np_dir != 0 and not na(np_htf_box)
    bool np_mitigated = (np_dir == 1 and close < np_htf_bot) or (np_dir == -1 and close > np_htf_top)
    if np_mitigated or not fvg5_show
        box.delete(np_htf_box)
        box.delete(np_ltf_box)
        np_htf_box := na
        np_ltf_box := na
        np_dir     := 0
    else
        box.set_right(np_htf_box, bar_index)
        box.set_right(np_ltf_box, bar_index)

// ─────────────────────────────────────────────────────────
//  RENDER TRADE TRACKER TABLE
// ─────────────────────────────────────────────────────────
if tbl_show and barstate.islast
    int  all_rows  = array.size(tlog_time)
    string today_str = str.format_time(time, "MM/dd", tbl_tz)

    var int[] filtered = array.new_int(0)
    array.clear(filtered)
    if all_rows > 0
        for i = 0 to all_rows - 1
            if not tbl_today_only or array.get(tlog_date, i) == today_str
                array.push(filtered, i)

    int frows = array.size(filtered)
    if frows > 0
        int start = math.max(0, frows - tbl_max_rows)
        int disp  = frows - start

        int   f_full = 0, f_losses = 0, f_partials = 0
        float f_pnl  = 0.0
        int   f_streak = 0
        for k = 0 to frows - 1
            int    ki = array.get(filtered, k)
            string kr = array.get(tlog_result, ki)
            float  kp = array.get(tlog_pnl,    ki)
            if kr == "✅ Win"
                f_full   += 1
                f_pnl    += kp
                f_streak  := f_streak < 0 ? 1 : f_streak + 1
            else if kr == "🔵 Partial"
                f_partials += 1
                f_pnl      += kp
                f_streak    := f_streak < 0 ? 1 : f_streak + 1
            else if kr == "❌ Loss"
                f_losses += 1
                f_pnl    += kp
                f_streak  := f_streak > 0 ? -1 : f_streak - 1
            else if kr == "⏳ Partial" or kr == "⏳ Win"
                f_pnl    += kp

        // HONEST: full-target wins only (partials/BE are NOT wins; kept as their own bucket).
        int   f_wins    = f_full

        // Best Day calculation
        var map<string, float> day_pnl_map = map.new<string, float>()
        var map<string, int>   day_win_map = map.new<string, int>()
        var map<string, int>   day_tot_map = map.new<string, int>()
        map.clear(day_pnl_map)
        map.clear(day_win_map)
        map.clear(day_tot_map)
        if all_rows > 0
            for k = 0 to all_rows - 1
                string kd = array.get(tlog_date,   k)
                string kr = array.get(tlog_result, k)
                float  kp = array.get(tlog_pnl,    k)
                float  cur_pnl = map.contains(day_pnl_map, kd) ? map.get(day_pnl_map, kd) : 0.0
                int    cur_win = map.contains(day_win_map, kd) ? map.get(day_win_map, kd) : 0
                int    cur_tot = map.contains(day_tot_map, kd) ? map.get(day_tot_map, kd) : 0
                map.put(day_pnl_map, kd, cur_pnl + kp)
                map.put(day_tot_map, kd, cur_tot + 1)
                if kr == "✅ Win" or kr == "🔵 Partial"
                    map.put(day_win_map, kd, cur_win + 1)
        string best_day_date = "N/A"
        float  best_day_pnl  = -999999.0
        string[] day_keys = map.keys(day_pnl_map)
        if array.size(day_keys) > 0
            for k = 0 to array.size(day_keys) - 1
                string dk = array.get(day_keys, k)
                float  dp = map.get(day_pnl_map, dk)
                if dp > best_day_pnl
                    best_day_pnl  := dp
                    best_day_date := dk
        int   best_day_wins = map.contains(day_win_map, best_day_date) ? map.get(day_win_map, best_day_date) : 0
        int   best_day_tot  = map.contains(day_tot_map, best_day_date) ? map.get(day_tot_map, best_day_date) : 0
        string best_day_str = best_day_date + " +" + str.tostring(math.round(best_day_pnl,1)) + "pts (" + str.tostring(best_day_wins) + "/" + str.tostring(best_day_tot) + "W)"
        // Win% denominator includes partials/BE so the rate reflects true target hits / all settled.
        int   f_settled = f_wins + f_partials + f_losses
        float f_wr      = f_settled > 0 ? (f_wins / f_settled) * 100 : 0.0
        string streak_str = f_streak > 0 ? "🔥 " + str.tostring(f_streak) + "W" : f_streak < 0 ? "🧊 " + str.tostring(math.abs(f_streak)) + "L" : "-"

        color hbg    = th_hbg
        color row_bg = th_row_bg
        color sum_bg = th_sum_bg

        int s_full = 0, s_losses = 0, s_partials = 0
        float s_pnl = 0.0
        int s_streak = 0
        for k = start to frows - 1
            int    ki = array.get(filtered, k)
            string kr = array.get(tlog_result, ki)
            float  kp = array.get(tlog_pnl,    ki)
            if kr == "✅ Win"
                s_full   += 1
                s_pnl    += kp
                s_streak  := s_streak < 0 ? 1 : s_streak + 1
            else if kr == "🔵 Partial"
                s_partials += 1
                s_pnl      += kp
                s_streak    := s_streak < 0 ? 1 : s_streak + 1
            else if kr == "❌ Loss"
                s_losses += 1
                s_pnl    += kp
                s_streak  := s_streak > 0 ? -1 : s_streak - 1
            else if kr == "⏳ Partial" or kr == "⏳ Win"
                s_pnl    += kp
        // HONEST: full-target wins only; partials kept in denominator, not as wins.
        int   s_wins    = s_full
        int   s_settled = s_wins + s_partials + s_losses
        float s_wr      = s_settled > 0 ? (s_wins / s_settled) * 100 : 0.0
        string s_streak_str = s_streak > 0 ? "🔥 " + str.tostring(s_streak) + "W" : s_streak < 0 ? "🧊 " + str.tostring(math.abs(s_streak)) + "L" : "-"

        int c_usd = 8
        int c_num = tbl_show_usd ? 9 : 8
        int ncols = tbl_show_usd ? 10 : 9

        table t = table.new(tbl_pos_conv, ncols, tbl_max_rows + 5,
             border_color=color.new(P_STRUCT_BASE, 50),
             border_width=1,
             frame_color=color.new(P_STRUCT_BASE, 30),
             frame_width=1)

        table.cell(t, 0, 0, "Date",    text_color=th_text, bgcolor=hbg, text_size=tbl_sz_conv, text_halign=text.align_center)
        table.cell(t, 1, 0, "Time",    text_color=th_text, bgcolor=hbg, text_size=tbl_sz_conv, text_halign=text.align_center)
        table.cell(t, 2, 0, "Dir",     text_color=th_text, bgcolor=hbg, text_size=tbl_sz_conv, text_halign=text.align_center)
        table.cell(t, 3, 0, "Entry",   text_color=th_text, bgcolor=hbg, text_size=tbl_sz_conv, text_halign=text.align_center)
        table.cell(t, 4, 0, "Stop",    text_color=th_text, bgcolor=hbg, text_size=tbl_sz_conv, text_halign=text.align_center)
        table.cell(t, 5, 0, "Target",  text_color=th_text, bgcolor=hbg, text_size=tbl_sz_conv, text_halign=text.align_center)
        table.cell(t, 6, 0, "Result",  text_color=th_text, bgcolor=hbg, text_size=tbl_sz_conv, text_halign=text.align_center)
        table.cell(t, 7, 0, "P&L pts", text_color=th_text, bgcolor=hbg, text_size=tbl_sz_conv, text_halign=text.align_center)
        if tbl_show_usd
            table.cell(t, c_usd, 0, "P&L $", text_color=th_text, bgcolor=hbg, text_size=tbl_sz_conv, text_halign=text.align_center)
        table.cell(t, c_num, 0, "#",   text_color=th_text, bgcolor=hbg, text_size=tbl_sz_conv, text_halign=text.align_center)

        for i = 0 to disp - 1
            int    idx = array.get(filtered, start + i)
            int    row = i + 1
            string res = array.get(tlog_result, idx)
            float  pnl = array.get(tlog_pnl,    idx)
            string dir = array.get(tlog_dir,     idx)
            // Alternate the two scorecard tones by row so it reads as soft rows,
            // not a flat black slab.
            color  row_bg = (i % 2 == 0) ? SB_DEEP : SB_ALT
            // Scorecard style: no per-cell backgrounds. Color lives in the TEXT.
            color  res_txt = str.contains(res, "Win") ? pal_table_long() : str.contains(res, "Loss") ? pal_table_short() : str.contains(res, "Partial") ? pal_table_info() : th_muted
            color  dir_txt = str.contains(dir, "Bull") ? pal_table_long() : pal_table_short()
            table.cell(t, 0, row, array.get(tlog_date, idx),                                text_color=th_muted,  bgcolor=row_bg, text_size=tbl_sz_conv, text_halign=text.align_center)
            table.cell(t, 1, row, array.get(tlog_time, idx),                                text_color=th_text,   bgcolor=row_bg, text_size=tbl_sz_conv, text_halign=text.align_center)
            table.cell(t, 2, row, dir,                                                       text_color=dir_txt,   bgcolor=row_bg, text_size=tbl_sz_conv, text_halign=text.align_center)
            table.cell(t, 3, row, str.tostring(math.round(array.get(tlog_entry,  idx),2)),  text_color=th_text,   bgcolor=row_bg, text_size=tbl_sz_conv, text_halign=text.align_right)
            table.cell(t, 4, row, str.tostring(math.round(array.get(tlog_stop,   idx),2)),  text_color=th_muted,  bgcolor=row_bg, text_size=tbl_sz_conv, text_halign=text.align_right)
            table.cell(t, 5, row, str.tostring(math.round(array.get(tlog_target, idx),2)),  text_color=th_muted,  bgcolor=row_bg, text_size=tbl_sz_conv, text_halign=text.align_right)
            table.cell(t, 6, row, res,                                                       text_color=res_txt,   bgcolor=row_bg, text_size=tbl_sz_conv, text_halign=text.align_center)
            table.cell(t, 7, row, (pnl >= 0 ? "+" : "") + str.tostring(math.round(pnl,1)), text_color=pnl >= 0 ? pal_table_long() : pal_table_short(), bgcolor=row_bg, text_size=tbl_sz_conv, text_halign=text.align_right)
            if tbl_show_usd
                float usd = pnl * tbl_usd_per_pt
                table.cell(t, c_usd, row, (usd >= 0 ? "+$" : "-$") + str.tostring(math.round(math.abs(usd))), text_color=usd >= 0 ? pal_table_long() : pal_table_short(), bgcolor=row_bg, text_size=tbl_sz_conv, text_halign=text.align_right)
            table.cell(t, c_num, row, str.tostring(array.get(tlog_num, idx)),               text_color=th_muted,   bgcolor=row_bg, text_size=tbl_sz_conv, text_halign=text.align_center)

        int   srow   = disp + 1
        // Summary row: uniform surface, pos/neg carried in TEXT color (cyan/red).
        color day_txt = stat_daily_pnl > 0 ? pal_table_long() : stat_daily_pnl < 0 ? pal_table_short() : th_muted
        color fpnl_txt = f_pnl > 0 ? pal_table_long() : f_pnl < 0 ? pal_table_short() : th_muted
        string mode_lbl = tbl_today_only ? "TODAY" : "ALL"
        table.cell(t, 0, srow, mode_lbl,                                                                                   text_color=th_muted, bgcolor=sum_bg, text_size=tbl_sz_conv, text_halign=text.align_center)
        table.cell(t, 1, srow, str.tostring(frows) + " trades",                                                            text_color=th_text, bgcolor=sum_bg, text_size=tbl_sz_conv, text_halign=text.align_center)
        table.cell(t, 2, srow, str.tostring(f_full) + "W " + str.tostring(f_losses) + "L " + str.tostring(f_partials) + "P", text_color=th_text, bgcolor=sum_bg, text_size=tbl_sz_conv, text_halign=text.align_center)
        table.cell(t, 3, srow, "WR: " + str.tostring(math.round(f_wr,1)) + "%",                                           text_color=th_text, bgcolor=sum_bg, text_size=tbl_sz_conv, text_halign=text.align_center)
        table.cell(t, 4, srow, "Streak: " + streak_str,                                                                    text_color=th_text, bgcolor=sum_bg, text_size=tbl_sz_conv, text_halign=text.align_center)
        table.cell(t, 5, srow, "Day: " + (stat_daily_pnl >= 0 ? "+" : "") + str.tostring(math.round(stat_daily_pnl,1)) + "pts", text_color=day_txt, bgcolor=sum_bg, text_size=tbl_sz_conv, text_halign=text.align_center)
        table.cell(t, 6, srow, "All: " + (stat_total_pnl >= 0 ? "+" : "") + str.tostring(math.round(stat_total_pnl,1)) + "pts", text_color=th_text, bgcolor=sum_bg, text_size=tbl_sz_conv, text_halign=text.align_center)
        table.cell(t, 7, srow, (f_pnl >= 0 ? "+" : "") + str.tostring(math.round(f_pnl,1)) + "pts",                      text_color=fpnl_txt, bgcolor=sum_bg, text_size=tbl_sz_conv, text_halign=text.align_center)
        if tbl_show_usd
            float f_usd = f_pnl * tbl_usd_per_pt
            table.cell(t, c_usd, srow, (f_usd >= 0 ? "+$" : "-$") + str.tostring(math.round(math.abs(f_usd))), text_color=fpnl_txt, bgcolor=sum_bg, text_size=tbl_sz_conv, text_halign=text.align_center)
        table.cell(t, c_num, srow, str.tostring(stat_total) + " total",                                                    text_color=th_muted, bgcolor=sum_bg, text_size=tbl_sz_conv, text_halign=text.align_center)

        if tbl_show_shown
            int   srow2    = disp + 2
            color s_pnl_txt = s_pnl > 0 ? pal_table_long() : s_pnl < 0 ? pal_table_short() : th_muted
            color shown_bg = sum_bg
            table.cell(t, 0, srow2, "SHOWN",                                                                               text_color=th_text, bgcolor=shown_bg, text_size=tbl_sz_conv, text_halign=text.align_center)
            table.cell(t, 1, srow2, str.tostring(disp) + " trades",                                                        text_color=th_text, bgcolor=shown_bg, text_size=tbl_sz_conv, text_halign=text.align_center)
            table.cell(t, 2, srow2, str.tostring(s_full) + "W " + str.tostring(s_losses) + "L " + str.tostring(s_partials) + "P", text_color=th_text, bgcolor=shown_bg, text_size=tbl_sz_conv, text_halign=text.align_center)
            table.cell(t, 3, srow2, "WR: " + str.tostring(math.round(s_wr,1)) + "%",                                      text_color=th_text, bgcolor=shown_bg, text_size=tbl_sz_conv, text_halign=text.align_center)
            table.cell(t, 4, srow2, "Streak: " + s_streak_str,                                                             text_color=th_text, bgcolor=shown_bg, text_size=tbl_sz_conv, text_halign=text.align_center)
            table.cell(t, 5, srow2, "",                                                                                     text_color=th_text, bgcolor=shown_bg, text_size=tbl_sz_conv, text_halign=text.align_center)
            table.cell(t, 6, srow2, "",                                                                                     text_color=th_text, bgcolor=shown_bg, text_size=tbl_sz_conv, text_halign=text.align_center)
            table.cell(t, 7, srow2, (s_pnl >= 0 ? "+" : "") + str.tostring(math.round(s_pnl,1)) + "pts",                  text_color=s_pnl_txt, bgcolor=shown_bg, text_size=tbl_sz_conv, text_halign=text.align_center)
            if tbl_show_usd
                float s_usd = s_pnl * tbl_usd_per_pt
                table.cell(t, c_usd, srow2, (s_usd >= 0 ? "+$" : "-$") + str.tostring(math.round(math.abs(s_usd))), text_color=s_pnl_txt, bgcolor=shown_bg, text_size=tbl_sz_conv, text_halign=text.align_center)
            table.cell(t, c_num, srow2, str.tostring(disp) + " shown",                                                     text_color=th_muted, bgcolor=shown_bg, text_size=tbl_sz_conv, text_halign=text.align_center)

        // Best Day row
        int   brow   = tbl_show_shown ? disp + 3 : disp + 2
        color best_bg = sum_bg
        table.cell(t, 0, brow, "BEST DAY",   text_color=pal_table_long(), bgcolor=best_bg, text_size=tbl_sz_conv, text_halign=text.align_center)
        table.cell(t, 1, brow, best_day_str, text_color=pal_table_long(), bgcolor=best_bg, text_size=tbl_sz_conv, text_halign=text.align_left)
        table.cell(t, 2, brow, "",           text_color=th_text, bgcolor=best_bg, text_size=tbl_sz_conv, text_halign=text.align_center)
        table.cell(t, 3, brow, "",           text_color=th_text, bgcolor=best_bg, text_size=tbl_sz_conv, text_halign=text.align_center)
        table.cell(t, 4, brow, "",           text_color=th_text, bgcolor=best_bg, text_size=tbl_sz_conv, text_halign=text.align_center)
        table.cell(t, 5, brow, "",           text_color=th_text, bgcolor=best_bg, text_size=tbl_sz_conv, text_halign=text.align_center)
        table.cell(t, 6, brow, "",           text_color=th_text, bgcolor=best_bg, text_size=tbl_sz_conv, text_halign=text.align_center)
        if tbl_show_usd
            float best_usd = best_day_pnl * tbl_usd_per_pt
            table.cell(t, c_usd, brow, "+$" + str.tostring(math.round(best_usd)), text_color=pal_table_long(), bgcolor=best_bg, text_size=tbl_sz_conv, text_halign=text.align_right)
        table.cell(t, c_num, brow, "", text_color=th_muted, bgcolor=best_bg, text_size=tbl_sz_conv, text_halign=text.align_center)

// ─────────────────────────────────────────────────────────
//  RENDER HOURLY PERFORMANCE TABLE
// ─────────────────────────────────────────────────────────
if tbl_hourly and barstate.islast
    tbl_hourly_pos_conv = switch tbl_hourly_pos
        "Top Right"    => position.top_right
        "Top Left"     => position.top_left
        "Bottom Right" => position.bottom_right
        "Bottom Left"  => position.bottom_left
        "Middle Right" => position.middle_right
        => position.middle_left

    array.clear(active_hours)
    for h = 0 to 23
        if array.get(hr_count, h) > 0
            array.push(active_hours, h)

    int ah = array.size(active_hours)
    if ah > 0
        table ht = table.new(tbl_hourly_pos_conv, 8, ah + 2,
             border_color=color.new(P_STRUCT_BASE, 50),
             border_width=1,
             frame_color=color.new(P_STRUCT_BASE, 30),
             frame_width=1)

        color hhbg = th_hbg
        // HONEST STATS: "Win %" counts only trades that reached the FULL TARGET.
        // Partials / break-even scratches are shown in their own column, not as wins.
        table.cell(ht, 0, 0, "Hour (CT)",  text_color=th_text, bgcolor=hhbg, text_size=tbl_sz_conv, text_halign=text.align_center)
        table.cell(ht, 1, 0, "Signals",    text_color=th_text, bgcolor=hhbg, text_size=tbl_sz_conv, text_halign=text.align_center)
        table.cell(ht, 2, 0, "Wins",       text_color=th_text, bgcolor=hhbg, text_size=tbl_sz_conv, text_halign=text.align_center)
        table.cell(ht, 3, 0, "Part/BE",    text_color=th_text, bgcolor=hhbg, text_size=tbl_sz_conv, text_halign=text.align_center)
        table.cell(ht, 4, 0, "Losses",     text_color=th_text, bgcolor=hhbg, text_size=tbl_sz_conv, text_halign=text.align_center)
        table.cell(ht, 5, 0, "Win %",      text_color=th_text, bgcolor=hhbg, text_size=tbl_sz_conv, text_halign=text.align_center)
        table.cell(ht, 6, 0, "P&L pts",    text_color=th_text, bgcolor=hhbg, text_size=tbl_sz_conv, text_halign=text.align_center)
        table.cell(ht, 7, 0, "Rating",     text_color=th_text, bgcolor=hhbg, text_size=tbl_sz_conv, text_halign=text.align_center)

        for i = 0 to ah - 1
            int   h    = array.get(active_hours, i)
            int   row  = i + 1
            int   ht_  = array.get(hr_count,   h)
            int   hw   = array.get(hr_wins,    h)               // HONEST: full-target wins only
            int   hp   = array.get(hr_partial, h)               // partials + break-even scratches
            int   hl   = array.get(hr_losses,  h)
            float hpnl = array.get(hr_pnl,    h)
            int   settled = hw + hp + hl
            float wr   = settled > 0 ? (hw / settled) * 100 : 0.0   // target-hit rate, not inflated
            // Rating is driven by REALIZED P&L (the honest metric), not win-rate, so an
            // hour full of break-even scratches is no longer flattered into "** USE **".
            float avg_pnl = ht_ > 0 ? hpnl / ht_ : 0.0
            bool is_strong    = hpnl >= 300 and avg_pnl > 0
            bool is_marginal  = hpnl > 0 and avg_pnl > 0
            bool is_weak      = hpnl < 0
            string rating = is_strong ? "** USE **" : is_marginal ? "* Use *" : is_weak ? "X Cut X" : "! Caution"
            color  rbg = rating == "** USE **" ? color.new(P_LONG_BASE, 0) : rating == "* Use *" ? color.new(P_LONG_BASE, 30) : rating == "X Cut X" ? color.new(P_SHORT_BASE, 20) : color.new(P_WARN_BASE, 30)
            color  pbg = hpnl > 0 ? color.new(pal_table_long(), 60) : color.new(pal_table_short(), 60)
            int    h12  = h == 0 ? 12 : h > 12 ? h - 12 : h
            string ampm = h < 12 ? "AM" : "PM"
            string hlbl = str.tostring(h12) + ":00 " + ampm
            color  hbg2 = th_hourly
            table.cell(ht, 0, row, hlbl,                                                               text_color=th_text,  bgcolor=hbg2, text_size=tbl_sz_conv, text_halign=text.align_center)
            table.cell(ht, 1, row, str.tostring(ht_),                                                 text_color=th_text,  bgcolor=hbg2, text_size=tbl_sz_conv, text_halign=text.align_center)
            table.cell(ht, 2, row, str.tostring(hw),                                                  text_color=pal_table_long(),  bgcolor=hbg2, text_size=tbl_sz_conv, text_halign=text.align_center)
            table.cell(ht, 3, row, str.tostring(hp),                                                  text_color=color.new(pal_table_info(), 0), bgcolor=hbg2, text_size=tbl_sz_conv, text_halign=text.align_center)
            table.cell(ht, 4, row, str.tostring(hl),                                                  text_color=pal_table_short(),    bgcolor=hbg2, text_size=tbl_sz_conv, text_halign=text.align_center)
            table.cell(ht, 5, row, str.tostring(math.round(wr, 1)) + "%",                             text_color=hpnl > 0 ? pal_table_long() : pal_table_short(), bgcolor=hbg2, text_size=tbl_sz_conv, text_halign=text.align_center)
            table.cell(ht, 6, row, (hpnl >= 0 ? "+" : "") + str.tostring(math.round(hpnl, 1)),       text_color=hpnl >= 0 ? pal_table_long() : pal_table_short(), bgcolor=pbg, text_size=tbl_sz_conv, text_halign=text.align_right)
            table.cell(ht, 7, row, rating,                                                             text_color=th_text,  bgcolor=rbg,  text_size=tbl_sz_conv, text_halign=text.align_center)

// ─────────────────────────────────────────────────────────
//  RENDER WEEKLY SUMMARY TABLE — per-day breakdown
// ─────────────────────────────────────────────────────────
if tbl_weekly and barstate.islast
    tbl_weekly_pos_conv = switch tbl_weekly_pos
        "Top Right"    => position.top_right
        "Top Left"     => position.top_left
        "Bottom Right" => position.bottom_right
        "Bottom Left"  => position.bottom_left
        "Middle Right" => position.middle_right
        => position.middle_left

    int cur_dow   = dayofweek(time, "America/Chicago")
    int cur_hour  = hour(time, "America/Chicago")
    int cur_min   = minute(time, "America/Chicago")
    int days_since_sun = cur_dow == 1 ? 0 : cur_dow - 1
    bool before_open = cur_dow == 1 and (cur_hour < 17)
    if before_open
        days_since_sun := 7
    int week_open_ts = time - days_since_sun * 86400000 - (cur_hour * 3600000) - (cur_min * 60000) + 17 * 3600000

    var int[]   day_wins   = array.new_int(5, 0)
    var int[]   day_losses = array.new_int(5, 0)
    var int[]   day_parts  = array.new_int(5, 0)
    var float[] day_pnl    = array.new_float(5, 0.0)
    var int[]   day_tot    = array.new_int(5, 0)
    for d = 0 to 4
        array.set(day_wins,   d, 0)
        array.set(day_losses, d, 0)
        array.set(day_parts,  d, 0)
        array.set(day_pnl,    d, 0.0)
        array.set(day_tot,    d, 0)

    int   wk_wins = 0, wk_losses = 0, wk_partials = 0, wk_total = 0
    float wk_pnl  = 0.0
    int   all_rows2 = array.size(tlog_ts)
    if all_rows2 > 0
        for k = 0 to all_rows2 - 1
            int    kts = array.get(tlog_ts,     k)
            string kr  = array.get(tlog_result, k)
            float  kp  = array.get(tlog_pnl,    k)
            if kts >= week_open_ts
                int trade_dow = dayofweek(kts, "America/Chicago")
                int d = trade_dow - 2
                if d >= 0 and d <= 4
                    array.set(day_tot,  d, array.get(day_tot, d) + 1)
                    array.set(day_pnl,  d, array.get(day_pnl, d) + kp)
                    if kr == "✅ Win" or str.contains(kr, "✅")
                        array.set(day_wins,   d, array.get(day_wins,   d) + 1)
                        wk_wins += 1
                    else if kr == "❌ Loss"
                        array.set(day_losses, d, array.get(day_losses, d) + 1)
                        wk_losses += 1
                    else if kr == "🔵 Partial"
                        array.set(day_parts,  d, array.get(day_parts,  d) + 1)
                        wk_partials += 1
                    wk_total += 1
                    wk_pnl   += kp
                else if kp != 0
                    wk_pnl += kp

    int   wk_settled = wk_wins + wk_losses + wk_partials
    float wk_wr      = wk_settled > 0 ? (wk_wins / wk_settled) * 100 : 0.0
    float wk_usd     = wk_pnl * tbl_usd_per_pt
    color wbg        = wk_pnl >= 0 ? color.new(P_LONG_BASE, 0) : color.new(P_SHORT_BASE, 0)

    string gate_txt = not dll_ok ? "⛔ DLL -$" + str.tostring(math.round(math.abs(daily_loss_usd))) : "DLL: -$" + str.tostring(math.round(math.abs(daily_loss_usd))) + "/$" + str.tostring(math.round(dll_usd))
    color gate_col  = not dll_ok ? pal_on_surface() : th_muted
    color gate_bg   = not dll_ok ? color.new(P_SHORT_BASE, 0) : th_hbg

    table wt = table.new(tbl_weekly_pos_conv, 6, 9,
         border_color=color.new(P_STRUCT_BASE, 50), border_width=1,
         frame_color=color.new(P_STRUCT_BASE, 30),  frame_width=1)

    table.cell(wt, 0, 0, "THIS WEEK", text_color=th_text, bgcolor=th_hbg, text_size=tbl_sz_conv, text_halign=text.align_center)
    table.cell(wt, 1, 0, "Trades",    text_color=th_text, bgcolor=th_hbg, text_size=tbl_sz_conv, text_halign=text.align_center)
    table.cell(wt, 2, 0, "W/L/P",     text_color=th_text, bgcolor=th_hbg, text_size=tbl_sz_conv, text_halign=text.align_center)
    table.cell(wt, 3, 0, "Win %",     text_color=th_text, bgcolor=th_hbg, text_size=tbl_sz_conv, text_halign=text.align_center)
    table.cell(wt, 4, 0, "P&L pts",   text_color=th_text, bgcolor=th_hbg, text_size=tbl_sz_conv, text_halign=text.align_center)
    table.cell(wt, 5, 0, "P&L $",     text_color=th_text, bgcolor=th_hbg, text_size=tbl_sz_conv, text_halign=text.align_center)

    string[] day_names = array.from("Mon","Tue","Wed","Thu","Fri")
    for d = 0 to 4
        int   dw   = array.get(day_wins,   d)
        int   dl   = array.get(day_losses, d)
        int   dp_  = array.get(day_parts,  d)
        int   dt   = array.get(day_tot,    d)
        float dpnl = array.get(day_pnl,    d)
        float dusd = dpnl * tbl_usd_per_pt
        int   ds   = dw + dl + dp_
        float dwr  = ds > 0 ? (dw / ds) * 100 : 0.0
        int   row  = d + 1
        bool  is_today = (cur_dow - 2) == d
        color day_bg   = is_today ? color.new(P_INFO_BASE, 70) : th_row_bg
        color day_name_col = is_today ? pal_table_info() : th_muted
        color pnl_bg2  = dpnl > 0 ? color.new(pal_table_long(), 70) : dpnl < 0 ? color.new(pal_table_short(), 70) : day_bg
        color pnl_col  = dpnl > 0 ? pal_table_long() : dpnl < 0 ? pal_table_short() : th_muted
        table.cell(wt, 0, row, array.get(day_names, d),                                                                        text_color=day_name_col, bgcolor=day_bg,   text_size=tbl_sz_conv, text_halign=text.align_center)
        table.cell(wt, 1, row, dt > 0 ? str.tostring(dt) : "-",                                                                text_color=th_text,      bgcolor=day_bg,   text_size=tbl_sz_conv, text_halign=text.align_center)
        table.cell(wt, 2, row, dt > 0 ? str.tostring(dw) + "W " + str.tostring(dl) + "L " + str.tostring(dp_) + "P" : "-",   text_color=th_text,      bgcolor=day_bg,   text_size=tbl_sz_conv, text_halign=text.align_center)
        table.cell(wt, 3, row, dt > 0 ? str.tostring(math.round(dwr,0)) + "%" : "-",                                          text_color=dt>0 ? (dwr>=50 ? pal_table_long() : pal_table_short()) : th_muted, bgcolor=day_bg, text_size=tbl_sz_conv, text_halign=text.align_center)
        table.cell(wt, 4, row, dt > 0 ? (dpnl>=0 ? "+" : "") + str.tostring(math.round(dpnl,1)) : "-",                        text_color=pnl_col,      bgcolor=pnl_bg2,  text_size=tbl_sz_conv, text_halign=text.align_right)
        table.cell(wt, 5, row, dt > 0 ? (dusd>=0 ? "+$" : "-$") + str.tostring(math.round(math.abs(dusd))) : "-",             text_color=pnl_col,      bgcolor=pnl_bg2,  text_size=tbl_sz_conv, text_halign=text.align_right)

    table.cell(wt, 0, 6, "TOTAL",                                                                                              text_color=pal_on_surface(), bgcolor=th_sum_bg, text_size=tbl_sz_conv, text_halign=text.align_center)
    table.cell(wt, 1, 6, str.tostring(wk_total) + " trades",                                                                   text_color=pal_on_surface(), bgcolor=th_sum_bg, text_size=tbl_sz_conv, text_halign=text.align_center)
    table.cell(wt, 2, 6, str.tostring(wk_wins) + "W " + str.tostring(wk_losses) + "L " + str.tostring(wk_partials) + "P",    text_color=pal_on_surface(), bgcolor=th_sum_bg, text_size=tbl_sz_conv, text_halign=text.align_center)
    table.cell(wt, 3, 6, str.tostring(math.round(wk_wr,1)) + "%",                                                              text_color=wk_wr>=50 ? pal_table_long() : pal_table_short(), bgcolor=th_sum_bg, text_size=tbl_sz_conv, text_halign=text.align_center)
    table.cell(wt, 4, 6, (wk_pnl>=0 ? "+" : "") + str.tostring(math.round(wk_pnl,1)) + " pts",                                text_color=pal_on_surface(), bgcolor=wbg,       text_size=tbl_sz_conv, text_halign=text.align_right)
    table.cell(wt, 5, 6, (wk_usd>=0 ? "+$" : "-$") + str.tostring(math.round(math.abs(wk_usd))),                              text_color=pal_on_surface(), bgcolor=wbg,       text_size=tbl_sz_conv, text_halign=text.align_right)

    string instr = tbl_usd_per_pt == 2.0 ? "MNQ @ $2/pt" : tbl_usd_per_pt == 20.0 ? "NQ @ $20/pt" : tbl_usd_per_pt == 5.0 ? "MES @ $5/pt" : tbl_usd_per_pt == 50.0 ? "ES @ $50/pt" : "$" + str.tostring(tbl_usd_per_pt) + "/pt"
    table.cell(wt, 0, 7, "Sun 5PM CT (" + str.tostring(days_since_sun) + "d ago)", text_color=th_muted, bgcolor=th_hbg, text_size=tbl_sz_conv, text_halign=text.align_center)
    table.cell(wt, 1, 7, instr,           text_color=th_muted, bgcolor=th_hbg, text_size=tbl_sz_conv, text_halign=text.align_center)
    table.cell(wt, 2, 7, "",              text_color=th_muted, bgcolor=th_hbg, text_size=tbl_sz_conv, text_halign=text.align_center)
    table.cell(wt, 3, 7, "",              text_color=th_muted, bgcolor=th_hbg, text_size=tbl_sz_conv, text_halign=text.align_center)
    table.cell(wt, 4, 7, gate_txt,        text_color=gate_col, bgcolor=gate_bg, text_size=tbl_sz_conv, text_halign=text.align_center)
    table.cell(wt, 5, 7, gate_txt,        text_color=gate_col, bgcolor=gate_bg, text_size=tbl_sz_conv, text_halign=text.align_center)

// ─────────────────────────────────────────────────────────
//  ALERTS
// ─────────────────────────────────────────────────────────
if alert_on_nest and bullNested
    alert('{"ticker":"' + syminfo.ticker + '","action":"buy","signal":"' + str.tostring(sig_count) + '","price":' + str.tostring(math.round(close,2)) + '}', alert.freq_once_per_bar_close)
if alert_on_nest and bearNested
    alert('{"ticker":"' + syminfo.ticker + '","action":"sell","signal":"' + str.tostring(sig_count) + '","price":' + str.tostring(math.round(close,2)) + '}', alert.freq_once_per_bar_close)
if alert_partial and outcome_partial
    alert('{"ticker":"' + syminfo.ticker + '","action":"exit","price":' + str.tostring(math.round(close,2)) + ',"quantity":1}', alert.freq_once_per_bar_close)
if alert_partial and outcome_partial_win
    alert('{"ticker":"' + syminfo.ticker + '","action":"exit","price":' + str.tostring(math.round(close,2)) + ',"quantity":1}', alert.freq_once_per_bar_close)
if alert_partial and outcome_be
    alert('{"ticker":"' + syminfo.ticker + '","action":"exit","price":' + str.tostring(math.round(close,2)) + ',"quantity":3}', alert.freq_once_per_bar_close)
if alert_stop and outcome_loss
    alert('{"ticker":"' + syminfo.ticker + '","action":"exit","price":' + str.tostring(math.round(close,2)) + ',"quantity":3}', alert.freq_once_per_bar_close)
if alert_target and outcome_target
    alert('{"ticker":"' + syminfo.ticker + '","action":"exit","price":' + str.tostring(math.round(close,2)) + ',"quantity":1}', alert.freq_once_per_bar_close)

if outcome_emergency
    alert('{"ticker":"' + syminfo.ticker + '","action":"exit","price":' + str.tostring(math.round(close,2)) + ',"quantity":3}', alert.freq_once_per_bar_close)

alertcondition(outcome_entry,       title="Trade Entered",       message="Trade Entered — price reached entry — {{ticker}} {{interval}} @ {{close}}")
alertcondition(bullNested,          title="Nested Bull (Buy)",   message='{"ticker":"{{ticker}}","action":"buy","price":{{close}},"quantity":3,"orderType":"market"}')
alertcondition(bearNested,          title="Nested Bear (Sell)",  message='{"ticker":"{{ticker}}","action":"sell","price":{{close}},"quantity":3,"orderType":"market"}')
alertcondition(outcome_partial,     title="Partial Filled",      message='{"ticker":"{{ticker}}","action":"exit","price":{{close}},"quantity":1}')
alertcondition(outcome_partial_win, title="Partial Win",         message='{"ticker":"{{ticker}}","action":"exit","price":{{close}},"quantity":1}')
alertcondition(outcome_be,          title="Break-Even Scratch",  message='{"ticker":"{{ticker}}","action":"exit","price":{{close}},"quantity":3}')
alertcondition(outcome_loss,        title="Stop Hit",            message="Stop Hit — {{ticker}} @ {{close}}")
alertcondition(outcome_target,      title="Target Hit",          message='{"ticker":"{{ticker}}","action":"exit","price":{{close}},"quantity":1}')
alertcondition(outcome_emergency,   title="Emergency Exit",        message='{"ticker":"{{ticker}}","action":"exit","price":{{close}},"quantity":3}')

// ─────────────────────────────────────────────────────────
//  PLOT MARKERS
// ─────────────────────────────────────────────────────────
plotshape(bullNested, "Nested Bull", shape.triangleup,   location.belowbar, sig_bull_col, size=size.small)
plotshape(bearNested, "Nested Bear", shape.triangledown, location.abovebar, sig_bear_col, size=size.small)
